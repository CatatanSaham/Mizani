    <string name="info_liquid_title">What does Liquid mean?</string>
    <string name="info_liquid_body">Liquid is the recorded balance across active wallets other than debt wallets. Across wallets includes debt wallets.</string>
    <string name="info_investment_gain_title">How is gain or loss calculated?</string>
    <string name="info_investment_gain_body">Gain or loss is your entered current value minus your entered cost basis, using the valuation date shown. It is a manual estimate, not a provider-reported return.</string>
    <string name="info_commitment_rate_title">About the reference rate</string>
    <string name="info_commitment_rate_body">This planning amount uses the daily reference rate saved when you created the bill. Your payment provider may use a different rate.</string>
    <string name="info_import_privacy_title">What happens to the message?</string>
    <string name="info_import_privacy_body">Mizani parses the message on this phone and discards its text. To prevent duplicates, it keeps the provider reference, or an exact-message fingerprint if there is no reference. Mizani never reads SMS automatically.</string>
    <string name="info_transaction_types_title">Which transaction type should I use?</string>
    <string name="info_transaction_types_body">Transfer moves money between your wallets; it is not income or spending. Refund is money returned for an earlier expense. Adjustment corrects a wallet balance without recording income or spending.</string>
    <string name="info_personalised_checkins_title">About personalised money check-ins</string>
    <string name="info_personalised_checkins_body">These are occasional prompts based on the check-in types you enable and records stored on this phone. They are separate from the daily reminder. Android may delay or block notifications; no names or amounts appear in them.</string>
    <string name="onboarding_currency_info_title">About your primary currency</string>
    <string name="onboarding_currency_info_body">This currency is used for your workspace totals, charts and planning. It is fixed after setup. You can still record money in other currencies when you have a saved reference rate.</string>
